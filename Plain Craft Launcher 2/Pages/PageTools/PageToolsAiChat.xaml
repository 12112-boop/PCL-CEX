<local:MyPageRight x:Class="PCL.PageToolsAiChat"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:PCL"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!-- 聊天 -->
            <local:MyCard Margin="0,15" Title="{DynamicResource Tools.AiChat.Chat.Title}">
                <StackPanel Margin="25,40,25,20">
                    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         x:Name="PanChatScroller" MaxHeight="430">
                        <StackPanel x:Name="PanMessages" />
                    </local:MyScrollViewer>
                    <TextBlock x:Name="LabEmpty" Text="{DynamicResource Tools.AiChat.Chat.Empty}"
                               TextWrapping="Wrap" Opacity="0.6" HorizontalAlignment="Center" Margin="0,20,0,20" />
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <local:MyTextBox x:Name="TextInput" Grid.Row="0" Grid.Column="0" MinHeight="56"
                                         MaxHeight="140" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         HintText="{DynamicResource Tools.AiChat.Chat.InputHint}"
                                         KeyDown="TextInput_KeyDown" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                            <local:MyButton x:Name="BtnSend" MinWidth="90" Height="32" Margin="0,0,0,8"
                                            Text="{DynamicResource Tools.AiChat.Action.Send}" ColorType="Highlight"
                                            Click="BtnSend_Click" />
                            <local:MyButton x:Name="BtnStop" MinWidth="90" Height="32" Margin="0,0,0,8"
                                            Text="{DynamicResource Tools.AiChat.Action.Stop}" ColorType="Red"
                                            Visibility="Collapsed" Click="BtnStop_Click" />
                            <local:MyButton x:Name="BtnClear" MinWidth="90" Height="32"
                                            Text="{DynamicResource Tools.AiChat.Action.Clear}"
                                            Click="BtnClear_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 接口设置 -->
            <local:MyCard x:Name="CardSettings" Margin="0,0,0,15"
                          Title="{DynamicResource Tools.AiChat.Settings.Title}" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{DynamicResource Tools.AiChat.Settings.Description}" TextWrapping="Wrap"
                               Opacity="0.75" FontSize="12" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Tools.AiChat.Settings.Provider}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbProvider" Height="30"
                                          SelectionChanged="CmbProvider_SelectionChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Tools.AiChat.Settings.BaseUrl}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="1" x:Name="TextBaseUrl" Height="30"
                                         HintText="{DynamicResource Tools.AiChat.Settings.BaseUrlHint}"
                                         TextChanged="Settings_TextChanged" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Tools.AiChat.Settings.ApiKey}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyTextBox Grid.Row="4" Grid.Column="1" x:Name="TextApiKey" Height="30"
                                         HintText="{DynamicResource Tools.AiChat.Settings.ApiKeyHint}"
                                         TextChanged="Settings_TextChanged" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Tools.AiChat.Settings.Model}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid Grid.Row="6" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox Grid.Column="0" x:Name="TextModel" Height="30"
                                             HintText="{DynamicResource Tools.AiChat.Settings.ModelHint}"
                                             TextChanged="Settings_TextChanged" />
                            <local:MyButton Grid.Column="1" x:Name="BtnGetModels" Margin="10,0,0,0" MinWidth="110"
                                            Height="30" Text="{DynamicResource Tools.AiChat.Settings.GetModels}"
                                            Visibility="Collapsed" Click="BtnGetModels_Click" />
                        </Grid>
                        <TextBlock Grid.Row="8" Grid.Column="0"
                                   Text="{DynamicResource Tools.AiChat.Settings.SystemPrompt}"
                                   VerticalAlignment="Top" Margin="0,0,12,0" />
                        <local:MyTextBox Grid.Row="8" Grid.Column="1" x:Name="TextSystemPrompt" MinHeight="60"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HintText="{DynamicResource Tools.AiChat.Settings.SystemPromptHint}"
                                         TextChanged="Settings_TextChanged" />
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                            <local:MyButton x:Name="BtnTestConnection" MinWidth="120" Height="30"
                                            Text="{DynamicResource Tools.AiChat.Action.TestConnection}"
                                            Click="BtnTestConnection_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

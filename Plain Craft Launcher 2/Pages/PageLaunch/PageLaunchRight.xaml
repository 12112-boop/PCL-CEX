<local:MyPageRight x:Class="PCL.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
                <StackPanel x:Name="PanCustom" />
                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.CommunityHint.Title}" x:Name="PanHint">
                    <local:MyIconButton LogoScale="1.1"
                                        SvgIcon="lucide/x"
                                        Height="20" Width="20" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        x:Name="BtnHintClose"
                                        Click="BtnHintClose_Click" />
                    <StackPanel Margin="25,38,23,15">
                        <TextBlock x:Name="LabHint1" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" />
                        <TextBlock x:Name="LabHint2" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" />
                    </StackPanel>
                </local:MyCard>
                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog">
                    <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap" />
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>

        <!-- 公告栏：悬浮在启动页右上角 -->
        <local:MyCard x:Name="PanAnnouncement"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Width="320" Margin="0,18,18,0" Panel.ZIndex="20"
                      Title="{DynamicResource Launch.Announcement.Title}"
                      Visibility="Collapsed">
            <local:MyIconButton x:Name="BtnAnnouncementCollapse"
                                Width="20" Height="20" Margin="0,12,8,0" LogoScale="0.8"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                SvgIcon="lucide/chevron-up"
                                ToolTip="{DynamicResource Launch.Announcement.Collapse}"
                                Click="BtnAnnouncementCollapse_Click" />
            <StackPanel Margin="18,38,14,12">
                <StackPanel x:Name="PanAnnouncementList" />
                <TextBlock x:Name="LabAnnouncementEmpty"
                           Margin="2,4,0,6" FontSize="12.5"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           Text="{DynamicResource Launch.Announcement.Empty}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="LabAnnouncementFooter"
                           Margin="2,4,0,2" FontSize="11"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           Visibility="Collapsed" />
            </StackPanel>
        </local:MyCard>

        <!-- 折叠后的入口 -->
        <local:MyIconButton x:Name="BtnAnnouncementExpand"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="34" Height="34" Margin="0,18,18,0" Panel.ZIndex="20"
                            SvgIcon="lucide/megaphone"
                            ToolTip="{DynamicResource Launch.Announcement.Expand}"
                            Click="BtnAnnouncementExpand_Click"
                            Visibility="Collapsed" />
    </Grid>
</local:MyPageRight>
